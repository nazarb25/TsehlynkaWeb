# Рантайм (docker-compose.yml / .env.local)
# Адреса API для `npm run dev` на своїй машині. На сервері рядок не потрібен:
# контейнер бере http://tsehlynka-api:8000/api/v1 зі спільної мережі `tsehlynka`.
API_BASE_URL=http://localhost:8000/api/v1
SITE_URL=http://localhost:3000
# true лише на бойовому домені, коли сайт можна індексувати
SITE_INDEXABLE=false
TELEGRAM_BOT_USERNAME=tsehlynka_bot
# Вхід через Telegram (BotFather → Login Widget → OpenID Connect); без них кнопка веде на помилку входу
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
GOOGLE_SITE_VERIFICATION=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=

# Збирання (вшиваються в образ; у CI беруться з оточення production)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_ORG=freelance-v4x
SENTRY_PROJECT=tsehlynka-web
SENTRY_AUTH_TOKEN=
